{
  "name": "nodewarden",
  "installCommand": "npm ci",
  "buildCommand": "npm run build:edgeone",
  "outputDirectory": "./dist",
  "nodeVersion": "22.11.0",
  "headers": [
    {
      "source": "/*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive, nosnippet"
        }
      ]
    },
    {
      "source": "/assets/*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "cloudFunctions": {
    "nodejs": {
      "maxDuration": 120
    }
  },
  "schedules": [
    {
      "name": "nodewarden-edgeone-backup",
      "cron": "0 3 * * *",
      "path": "/api/cron/backup",
      "method": "POST",
      "timezone": "UTC"
    }
  ]
}
